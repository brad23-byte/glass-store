# Required in production: long random string (npm run setup creates one for local use)
JWT_SECRET=

# Payments. Cash on delivery is always available (can be switched off in Admin > Settings).
# Razorpay (UPI, cards, netbanking, wallets): get keys from the Razorpay dashboard.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Test payments (no real money). On by default in development, OFF in production unless set to true.
ALLOW_DEMO_PAYMENTS=

# Optional: lets a scheduler call /api/cron/sync-suppliers with header "x-cron-secret"
CRON_SECRET=
